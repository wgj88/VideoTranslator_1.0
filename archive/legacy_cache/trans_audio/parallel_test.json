[{"text": "\u7b2c\u4e00\u53e5\u6d4b\u8bd5\uff1a\u6b22\u8fce\u6765\u5230\u60ca\u609a\u5267\u573a\u3002"}, {"text": "\u7b2c\u4e8c\u53e5\u6d4b\u8bd5\uff1a\u771f\u76f8\u5f80\u5f80\u9690\u85cf\u5728\u9634\u5f71\u4e4b\u4e2d\u3002"}, {"text": "\u7b2c\u4e09\u53e5\u6d4b\u8bd5\uff1a\u8bf7\u95ed\u4e0a\u773c\uff0c\u9759\u9759\u8046\u542c\u3002"}]